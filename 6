let num1 = Number(prompt("Digite o primeiro número:"));
let num2 = Number(prompt("Digite o segundo número:"));
let operacao = prompt("Digite +, -, * ou /");
if (operacao === "+"){
    alert(num1 + num2);
}else if (operacao === "-"){
    alert(num1 - num2);
}else if (operacao === "*"){
    alert(num1 * num2);
}else if (operacao === "/"){
    alert(num1 / num2);
}
